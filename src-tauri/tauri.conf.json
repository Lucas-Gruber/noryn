{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noryn",
  "version": "0.1.3",
  "identifier": "dev.noryn.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Noryn",
        "width": 1440,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 680,
        "backgroundColor": "#171a20",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "app", "dmg"],
    "shortDescription": "Remote workspace for SSH, SFTP, FTP and FTPS",
    "category": "DeveloperTool",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1QkFEQ0VBRDY1QTM5MDMKUldRRE9Wclc2dHk2aGVhcE96cFZPYXMvVzM1bzJJVU5tYmxlVzZlOENITGl3OWpVb3Q4Yms3dnQK",
      "endpoints": ["https://github.com/Lucas-Gruber/noryn/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
