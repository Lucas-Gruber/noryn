{
  "name": "noryn",
  "private": true,
  "version": "0.1.7",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "release:version": "python scripts/bump_version.py",
    "format": "prettier --write src vite.config.ts *.json *.yaml docs README.md",
    "format:check": "prettier --check src vite.config.ts *.json *.yaml docs README.md",
    "test:otp": "node scripts/test-otp.mjs",
    "test:ftp": "python scripts/test-ftp.py",
    "test:ssh": "bash scripts/test-ssh.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "^3.6.0",
    "ssh2": "^1.17.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vue-tsc": "^3.0.0"
  }
}
